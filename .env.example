# NAMASTE Sentinel Environment Configuration Template

# Supabase PostgreSQL Connection URI
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# Supabase Project Credentials (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# Frontend API URL (for independent Vercel / Netlify static hosting)
# Example: https://namaste-sentinel-api.onrender.com
VITE_API_URL=https://namaste-sentinel-api.onrender.com
